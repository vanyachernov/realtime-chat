<Window x:Class="RealtimeChat.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RealtimeChat.Client.Wpf.ViewModels"
        Title="RealtimeChat" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="60" />
            <!-- Messages -->
            <RowDefinition Height="*" />
            <!-- Input area -->
            <RowDefinition Height="Auto" />
            <!-- Status bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB">
            <Grid Margin="20,0">
                <TextBlock Text="RealtimeChat"
                           Foreground="#111827"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Username, StringFormat='Signed in as {0}'}"
                               Foreground="#6B7280"
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages list -->
        <ItemsControl Grid.Row="1"
                       ItemsSource="{Binding Messages}"
                       x:Name="MessagesList"
                       Margin="0"
                       Background="Transparent"
                       BorderThickness="0"
                       VirtualizingStackPanel.IsVirtualizing="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" Padding="14,12" CornerRadius="12" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Username}"
                                           Foreground="#3B82F6"
                                           FontSize="13"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding Content}"
                                           Foreground="#1F2937"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Timestamp}"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       VerticalAlignment="Bottom"
                                       Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Input area -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="20" Margin="0,0,12,0">
                    <TextBox Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             Foreground="#111827"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,10"
                             CaretBrush="#3B82F6"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <Button Grid.Column="1"
                        Command="{Binding SendCommand}"
                        Width="44" Height="44"
                        Foreground="#FFFFFF"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="#3B82F6"
                                                CornerRadius="22"
                                                Padding="{TemplateBinding Padding}">
                                            <!-- Paper plane SVG path -->
                                            <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" 
                                                  Fill="#FFFFFF" 
                                                  Stretch="Uniform" 
                                                  Margin="12,12,10,12" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="#9CA3AF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">
            <TextBlock Text="{Binding ConnectionStatus}"
                       Foreground="#6B7280"
                       FontSize="11"
                       Margin="16,0"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
