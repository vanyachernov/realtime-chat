<Window x:Class="RealtimeChat.Client.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Chat" Height="260" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Welcome to RealtimeChat"
                   Foreground="#111827"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
                   
        <TextBlock Grid.Row="2"
                   Text="Enter your username to join the conversation"
                   Foreground="#6B7280"
                   FontSize="14"
                   HorizontalAlignment="Center" />

        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="UsernameBox"
                     FontSize="15"
                     Foreground="#111827"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,10"
                     CaretBrush="#3B82F6"
                     VerticalContentAlignment="Center"
                     MaxLength="100" />
        </Border>

        <Button Grid.Row="6"
                Content="Join Chat"
                Click="JoinButton_Click"
                FontSize="15"
                FontWeight="SemiBold"
                Height="44"
                Foreground="#FFFFFF"
                Cursor="Hand"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="#3B82F6"
                                        CornerRadius="8"
                                        Padding="0,6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2563EB" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
